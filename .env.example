# ==============================================================================
# Whisper Free — Configuration
# Copy this file to `.env` and adjust as needed.
# All variables are optional; defaults are shown.
# ==============================================================================

# --- Whisper (Speech-to-Text) -------------------------------------------------
# Model sizes: tiny, base, small, medium, large-v3, large-v3-turbo, distil-large-v3
# large-v3-turbo is the best speed/quality trade-off for an RTX 3060 12GB.
WHISPER_FREE_WHISPER__MODEL_SIZE=large-v3-turbo
# device: cuda | cpu | auto
WHISPER_FREE_WHISPER__DEVICE=cuda
# compute_type: int8_float16 (fast, ~2.8GB VRAM) | float16 (~4.5GB) | int8 (~2GB)
WHISPER_FREE_WHISPER__COMPUTE_TYPE=int8_float16
# Spoken language (pt = Portuguese). Leave empty for auto-detection.
WHISPER_FREE_WHISPER__LANGUAGE=pt
WHISPER_FREE_WHISPER__BEAM_SIZE=5
WHISPER_FREE_WHISPER__VAD_FILTER=true
# Keep context between segments (usually worse for short dictations).
WHISPER_FREE_WHISPER__CONDITION_ON_PREVIOUS_TEXT=false
# CPU threads used when device=cpu (0 = auto).
WHISPER_FREE_WHISPER__CPU_THREADS=0
# Retry on CPU/int8 when CUDA cannot be initialised (missing cuDNN, old driver).
WHISPER_FREE_WHISPER__FALLBACK_TO_CPU=true
# Free VRAM as soon as each dictation ends (model reloads on the next hotkey).
WHISPER_FREE_WHISPER__UNLOAD_AFTER_USE=true
# Idle timeout used only when UNLOAD_AFTER_USE=false (0 = keep it warm forever).
WHISPER_FREE_WHISPER__IDLE_UNLOAD_SECONDS=60
# Model cache directory (default: <PROJECT_ROOT>/models).
# WHISPER_FREE_WHISPER__MODEL_DIR=D:\models

# --- Grammar correction --------------------------------------------------------
WHISPER_FREE_GRAMMAR__ENABLED=true
WHISPER_FREE_GRAMMAR__LANGUAGE=pt-BR
# Automatically download a portable JRE 17 into ./runtime/jre when Java 17+
# is not found on the system (recommended).
WHISPER_FREE_GRAMMAR__AUTO_DOWNLOAD_JAVA=true
# Maximum number of LanguageTool suggestions applied per dictation.
WHISPER_FREE_GRAMMAR__MAX_MATCHES=5
# Reserved: the current corrector does not pass this to LanguageTool yet.
# WHISPER_FREE_GRAMMAR__TIMEOUT_SECONDS=15

# --- Audio ----------------------------------------------------------------------
WHISPER_FREE_AUDIO__SAMPLE_RATE=16000
WHISPER_FREE_AUDIO__CHANNELS=1
WHISPER_FREE_AUDIO__BLOCKSIZE=1024
# Input device index or name. Leave empty for system default.
WHISPER_FREE_AUDIO__DEVICE=

# --- Hotkey ---------------------------------------------------------------------
# hold  = push-to-talk (hold the keys while speaking)
# toggle = press once to start, press again to stop
WHISPER_FREE_HOTKEY__MODE=hold
WHISPER_FREE_HOTKEY__TRIGGER=ctrl+shift+space
# Hotkey that enables/disables the assistant entirely
WHISPER_FREE_HOTKEY__TOGGLE_ENABLED=ctrl+shift+f12
# Hotkey for cloud dictation via the OpenAI API (second mode)
WHISPER_FREE_HOTKEY__CLOUD_TRIGGER=ctrl+alt+space
# Swallow the recording hotkey so the focused app does not receive it.
WHISPER_FREE_HOTKEY__SUPPRESS=true

# --- Overlay (visual indicator) ---------------------------------------------------
WHISPER_FREE_OVERLAY__ENABLED=true
# position: top-center | center | mouse | bottom-center
WHISPER_FREE_OVERLAY__POSITION=bottom-center
# How long the success/error badge stays visible (0 = hide immediately).
WHISPER_FREE_OVERLAY__ALWAYS_SHOW_ON_SUCCESS_MS=1200

# --- Text injection -----------------------------------------------------------------
# paste = clipboard + Ctrl+V (fastest, handles every unicode char)
# type  = native SendInput unicode typing (no clipboard usage)
WHISPER_FREE_INJECTOR__MODE=paste
WHISPER_FREE_INJECTOR__RESTORE_CLIPBOARD=true
# Type the text directly when the clipboard cannot be written (locked, RDP...).
WHISPER_FREE_INJECTOR__FALLBACK_TO_TYPE=true
WHISPER_FREE_INJECTOR__CHAR_INTERVAL_S=0.001
WHISPER_FREE_INJECTOR__PRE_INJECT_DELAY_S=0.05

# --- Startup -------------------------------------------------------------------------
WHISPER_FREE_STARTUP__AUTO_START=false

# --- OpenAI (cloud transcription) ---------------------------------------------
# Used by the second hotkey for more elaborate texts. Leave API_KEY empty to
# disable the cloud dictation (the local hotkey keeps working).
WHISPER_FREE_OPENAI__ENABLED=true
WHISPER_FREE_OPENAI__API_KEY=
WHISPER_FREE_OPENAI__MODEL=gpt-4o-transcribe
WHISPER_FREE_OPENAI__BASE_URL=https://api.openai.com/v1
WHISPER_FREE_OPENAI__LANGUAGE=pt
WHISPER_FREE_OPENAI__PROMPT=
WHISPER_FREE_OPENAI__TIMEOUT_SECONDS=60

# --- General ----------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
WHISPER_FREE_LOG_LEVEL=INFO
# Prevent a second instance from starting.
WHISPER_FREE_SINGLE_INSTANCE=true
